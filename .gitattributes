* text=auto eol=lf

# Windows scripts that should stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Common text formats (explicit LF)
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.pdf binary
